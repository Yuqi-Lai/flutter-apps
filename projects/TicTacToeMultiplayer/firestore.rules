rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection - users can read all, but only write their own
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Games collection
    match /games/{gameId} {
      // Anyone authenticated can read games
      allow read: if request.auth != null;
      
      // Anyone authenticated can create a game
      allow create: if request.auth != null 
        && request.resource.data.playerX.userId == request.auth.uid;
      
      // Players in the game can update it
      // Allow update if:
      // 1. User is playerX, OR
      // 2. User is playerO (if playerO exists), OR
      // 3. Game is waiting (playerO is null) and user is joining as playerO
      allow update: if request.auth != null && (
        resource.data.playerX.userId == request.auth.uid ||
        (resource.data.playerO != null && resource.data.playerO.userId == request.auth.uid) ||
        (resource.data.playerO == null && resource.data.status == 'waiting' && 
         request.resource.data.playerO.userId == request.auth.uid)
      );
      
      // Only allow deletion if user is a player (optional - you may want to disable deletion)
      allow delete: if request.auth != null 
        && (resource.data.playerX.userId == request.auth.uid 
            || (resource.data.playerO != null && resource.data.playerO.userId == request.auth.uid));
    }
  }
}

